// --- Interfaces ---
interface Product {
  id: string;
  barcode: string;
  name: string;
  price: number;
  sellingPrice?: number;
  RetailSellingPrice?: number;
  quantity: number;
  stockQuantity?: number | null;
  availabilityStatus?: 'AVAILABLE' | 'UNAVAILABLE' | 'DISCONTINUED';
  inventoryTracking?: 'NOT_TRACKED' | 'TRACKED';
  imageUrl?: string;
}

interface BillItem extends Product {
  qty: number | string;
  total: number;
  GST: number;
  gstPrice?: number;
  finalPrice?: number;
  Discount: number | string; // %
  discountAmt?: number | string; // Amount
  purchaseRate?: number;
  RetailSellingPrice?: number;
  sellingPrice?: number;
  systemType?: "Retail" | "Retail";
}


